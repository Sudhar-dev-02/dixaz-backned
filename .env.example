# Environment
NODE_ENV=production
PORT=3000

# Application URL (for production deployment, set to your production domain: e.g. https://dixaz.com)
APP_URL=https://your-domain.com

# CORS Allowed Origins
# If frontend is deployed on a different domain (e.g. Vercel, Netlify), list it here separated by commas:
# Example: CORS_ORIGIN=https://dixaz.vercel.app,https://your-domain.com
CORS_ORIGIN=https://your-domain.com

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=dixaz_office

# Admin Login Credentials (Change these to your preferred login)
ADMIN_EMAIL=admin@dixaz.com
ADMIN_PASSWORD=change_this_to_a_strong_password
DIXAZ_OWNER_EMAIL=admin@dixaz.com

# Optional: Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cookie Settings: "lax" for same-domain, "none" for cross-origin HTTPS
COOKIE_SAMESITE=lax
